# eBay Browse API credentials (developer.ebay.com -> My Keys -> Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Optional: set the Discord webhook here instead of in the Settings tab
DISCORD_WEBHOOK_URL=

# Seconds between sweeps of every active watch
POLL_INTERVAL_SECONDS=300
# Hours before a cached TCGplayer market price is refreshed
PRICE_REFRESH_HOURS=12
