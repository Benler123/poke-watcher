# Hosted Postgres (Supabase: Project Settings -> Database -> Connection string -> URI).
# Leave blank to fall back to a local SQLite file at DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=data/poke_watcher.db

# eBay Browse API credentials (developer.ebay.com -> My Keys -> Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# eBay marketplace account deletion endpoint (required before production keys work).
# Can also be set in the Settings tab. The endpoint must be the exact public URL eBay calls.
EBAY_VERIFICATION_TOKEN=
EBAY_NOTIFICATION_ENDPOINT=

# Optional: set the Discord webhook here instead of in the Settings tab
DISCORD_WEBHOOK_URL=

# Seconds between sweeps of every active watch
POLL_INTERVAL_SECONDS=300
# Hours between automatic card index rebuilds (0 disables; index still builds from Settings)
INDEX_REFRESH_HOURS=24

# Fanatics Collect watches and their sweep interval (seconds)
FANATICS_ENABLED=true
FANATICS_POLL_INTERVAL_SECONDS=60
